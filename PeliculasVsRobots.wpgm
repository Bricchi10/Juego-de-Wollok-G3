import wollok.game.*
import terminator.*
import robot.*
import direcciones.*

program PeliculasVsRobots {
	game.title("Peliculas vs Robots")
	game.width(14)
    game.height(7)
    game.cellSize(50)
    game.boardGround("Fondo.jpg")

    game.addVisual(terminator)
  
	keyboard.up().onPressDo({ terminator.subir()})
	keyboard.down().onPressDo({ terminator.bajar()})
    keyboard.d().onPressDo({ terminator.disparar()})


    //game.onCollideDo

    game.onTick(4000, "aparecenRobots", { spawnerRobots.generarRobot() })
    game.onTick(1500, "muevenRobots", { spawnerRobots.moverRobots() })

	game.start()
}

