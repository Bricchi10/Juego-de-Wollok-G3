import wollok.game.*
import terminator.*
import robot.*
import direcciones.*

import example.pepita

program PepitaGame {
	game.title("Pepita")
	
    game.width(14)
    game.height(6)
	// VISUALES
   game.addVisual(terminator)
   game.addVisual(robot)
   game.boardGround("Fondo.jpg")
    //TECLAS
    keyboard.s().onPressDo({ robot.mover(izquierda)})
	keyboard.d().onPressDo({ robot.mover(derecha)})
    keyboard.w().onPressDo({ robot.mover(arriba)})
	keyboard.a().onPressDo({ robot.mover(abajo)})
	//INICIA EL JUEGO
    game.start()
}

