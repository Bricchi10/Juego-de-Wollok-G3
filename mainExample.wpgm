import wollok.game.*
import terminator.*
import robot.*
import example.pepita

program PepitaGame {
	game.title("Pepita")
	
    game.width(14)
    game.height(6)
	// add assets in asset folder, for example, for the background
   game.addVisual(terminator)
   game.addVisual(robot)
   game.boardGround("Fondo.jpg")
	game.start()
}

