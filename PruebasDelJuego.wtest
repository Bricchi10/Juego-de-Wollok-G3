import robot.*
import personajes.*
import proyectiles.*
import direcciones.*
import etapaDelJuego.*

describe "Pruebas de Peliculas vs Robots" {
  const bala = new Bala(disparador = personaje)
  const robotNormal = new Robot(position = game.at(5,5) ) 
  const robotFuerte = new RobotFuerte(position = game.at(5,5))
  const personaje = new Personaje(personajeActual = terminator)
  const robotEscudero = new RobotEscudero(position = game.at(5,5))
  const robotVeloz = new RobotVeloz(position = game.at(4,5) )
  const carga = new Carga(position = game.at(1,5))
  const robotRandom = spawnerRobots.robotAleatorio()

  //Pruebas con robots
  test "Al ser herido el robot normal pierde 50 de vida(toda su vida)"{
    robotNormal.teHirieron()
    assert.equals(0,robotNormal.vida())
  }
  test "Al ser herido el robot fuerte pierde 50 de vida(tiene 100)"{
    robotFuerte.teHirieron()
    assert.equals(50,robotFuerte.vida())
  }
  test "Robot normal es protegido de un disparo despues de aumentar su defensa"{
    robotNormal.aumentaDefensa()
    robotNormal.teHirieron()
    assert.equals(50, robotNormal.vida())
  }

  test "Robot normal muere de dos disparos despues de aumentar su defensa"{
    robotNormal.aumentaDefensa()
    robotNormal.teHirieron()
    robotNormal.teHirieron()
    assert.equals(0, robotNormal.vida())
  }

  test "Robot fuerte es protegido de un disparo despues de aumentar su defensa"{
    robotFuerte.aumentaDefensa()
    robotFuerte.teHirieron()
    assert.equals(100,robotFuerte.vida())
  }

  test "El robot escudero no recibe daño cuando esta detenido"{
    robotEscudero.aumentaDefensaDeRobots()
    robotEscudero.teHirieron()
    assert.equals(400, robotEscudero.vida() )
  }

  test "El robot escudero recibe daño cuando no esta detenido"{
    robotEscudero.teHirieron()
    assert.equals(350, robotEscudero.vida() )
  }

  test "El robot escudero no se aumenta la defensa a si mismo"{
    spawnerRobots.generarJefe(robotEscudero)
    robotEscudero.activarHabilidad()
    robotEscudero.dejaDeCubrirse()
    robotEscudero.teHirieron()
    assert.equals(350, robotEscudero.vida())
  }

  test "El robot escudero aumenta la defensa del resto de robots"{
    spawnerRobots.agregarRobot(robotRandom)
    const vidaInicialDelRobotRandom = robotRandom.vida()
    spawnerRobots.generarJefe(robotEscudero)
    robotEscudero.activarHabilidad()
    robotRandom.teHirieron()
    assert.equals(vidaInicialDelRobotRandom, robotRandom.vida())
  }

  test "Un robot random recibe daño al ser herido"{
    spawnerRobots.agregarRobot(robotRandom)
    const vidaInicialDelRobotRandom = robotRandom.vida()
    robotRandom.teHirieron()
    assert.notEquals(vidaInicialDelRobotRandom, robotRandom.vida())
  }

  test "Si en la lista robot activos esta robotEscudero y robotNormal al eliminar al robotEscudero solo queda robotNormal en la lista"{
    spawnerRobots.generarJefe(robotEscudero)
    spawnerRobots.eliminarRobot(robotEscudero)
    assert.equals([robotNormal], spawnerRobots.robotsActivos() + [robotNormal])
  }

  test "Limpiar robots elimina a todos los robots de la lista robots activos"{
    spawnerRobots.generarJefe(robotEscudero)
    spawnerRobots.agregarRobot(robotRandom)
    spawnerRobots.limpiarRobots()
    assert.equals([], spawnerRobots.robotsActivos() )
  }

  test "Robot Veloz al cambiar su etapa a caminar tambien cambia su imagen"{
    robotVeloz.etapa(camina) 
    assert.equals(camina,robotVeloz.etapa())
    assert.equals("robotVelozCamina.png", robotVeloz.image() )
  }

  test "Robot Veloz al cambiar su etapa a correr tambien cambia su imagen"{
    robotVeloz.etapa(corre) 
    assert.equals(corre,robotVeloz.etapa())
    assert.equals("robotVelozAtaque.png", robotVeloz.image() )
  }

  test "Robot Veloz al cambiar su etapa a pausa tambien cambia su imagen"{
    robotVeloz.etapa(pausa) 
    assert.equals(pausa,robotVeloz.etapa())
    assert.equals("robotVelozPreparaAtaque.png", robotVeloz.image() )
  }
  //Pruebas con personajes
  test "Al ser herido el personaje pierde 20 de vida"{ //tomo en cuenta la clase personaje ya que todos responderan a el daño igual
    personaje.teHirieron()
    assert.equals(80, personaje.vida())
  }

  test "La vida del personaje vuelve a ser 100 si se reinicia"{
    personaje.teHirieron()
    personaje.reiniciarVida()
    assert.equals(100, personaje.vida())
  }

  test "Al reiniciar la vida de el protagonista esta vuelve a 100 aun si fue dañado antes del reinicio"{
    personaje.teHirieron()
    personaje.teHirieron()
    personaje.reiniciarVida()
    assert.equals(100, personaje.vida() )
  }

  test "Al reiniciar la municion de el protagonista esta vuelve a 10 aun si gasto antes del reinicio"{
    personaje.dispararProyectil()
    personaje.dispararProyectil()
    personaje.reiniciarBalas()
    assert.equals(10, personaje.balas() )
  }
  //Pruebas con proyectiles
  test "Bala baja la vida de robot al chocar con este " {
    bala.herirA(robotFuerte)
    assert.equals(50, robotFuerte.vida())
  }

  test "Cuando el protagonista dispara este gasta esa municion"{
    personaje.dispararProyectil()
    personaje.dispararProyectil()
    assert.equals(8, personaje.balas() )
  }

  test "Cuando el protagonista se choca con una carga este recarga"{
    carga.chocarConPersonaje(personaje) //agrega 5 municones a las que ya tenia el protagonista
    assert.equals(15, personaje.balas() ) //la municion del protagonista siempre empieza en 10
  }
}