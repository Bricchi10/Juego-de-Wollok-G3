import wollok.game.*

import terminator.*
import robot.*

program juego {
  game.width(15)
  game.height(10)
  game.title("Juego")
  game.boardGround("Fondo.jpg")
  game.cellSize(50)

  game.addVisual(terminator)
  game.onTick(4000, "aparecenRobots", { spawnerRobots.generarRobot() })
  game.onTick(1500, "muevenRobots", { spawnerRobots.moverRobots() })
  game.start()
}